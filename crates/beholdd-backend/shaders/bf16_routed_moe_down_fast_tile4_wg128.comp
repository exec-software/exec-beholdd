#version 460

// Expert-major Tile4 BF16 routed-MoE stage 2. Each workgroup owns one
// {expert, hidden row}; a lane loads each down-projection BF16 pair once and
// applies it to up to four independently reduced item-route occurrences.
//
// Indirect dispatch: {hidden_size, tile_count, 1}
//   gl_WorkGroupID.x = hidden row
//   gl_WorkGroupID.y = expert-major tile
//
// Bindings, six-word push constants, combined metadata prefix, and eight-word
// tile records exactly match bf16_routed_moe_gate_up_fast_tile4_wg128.comp.
// Binding 0 is tightly packed f32 stage-1 scratch [N,K,F], binding 1 is the
// complete BF16 arena block, and binding 2 is f32 route scratch [N,K,H].
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly restrict buffer SourceActivations {
    vec2 source_pairs[];
};
layout(set = 0, binding = 1, std430) readonly restrict buffer PackedWeight {
    uint weight_words[];
};
layout(set = 0, binding = 2, std430) writeonly restrict buffer DestinationActivations {
    float destination_values[];
};
layout(set = 0, binding = 3, std430) readonly restrict buffer CombinedMetadata {
    uint route_meta[];
};

layout(push_constant) uniform Parameters {
    uint hidden_size;
    uint intermediate_size;
    uint route_count;
    uint accumulate;
    uint batch_size;
    uint tile_word_offset;
} pc;

shared float partial0[128];
shared float partial1[128];
shared float partial2[128];
shared float partial3[128];

vec2 unpack_bf16_pair(uint packed) {
    return uintBitsToFloat(uvec2(packed << 16u, packed & 0xffff0000u));
}

void main() {
    uint hidden = gl_WorkGroupID.x;
    uint tile_word = pc.tile_word_offset + gl_WorkGroupID.y * 8u;
    uint count = route_meta[tile_word + 3u];
    uint occurrence0 = route_meta[tile_word + 4u];
    uint occurrence1 = route_meta[tile_word + 5u];
    uint occurrence2 = route_meta[tile_word + 6u];
    uint occurrence3 = route_meta[tile_word + 7u];
    uint lane = gl_LocalInvocationID.x;

    uint intermediate_words = pc.intermediate_size >> 1u;
    uint source_word0 = occurrence0 * intermediate_words;
    uint source_word1 = occurrence1 * intermediate_words;
    uint source_word2 = occurrence2 * intermediate_words;
    uint source_word3 = occurrence3 * intermediate_words;
    uint row_word = route_meta[tile_word + 2u] + hidden * intermediate_words;

    float sum0 = 0.0;
    float sum1 = 0.0;
    float sum2 = 0.0;
    float sum3 = 0.0;
    for (uint pair = lane; pair < intermediate_words; pair += 128u) {
        vec2 weight_pair = unpack_bf16_pair(weight_words[row_word + pair]);

        sum0 += dot(weight_pair, source_pairs[source_word0 + pair]);
        if (count > 1u) {
            sum1 += dot(weight_pair, source_pairs[source_word1 + pair]);
        }
        if (count > 2u) {
            sum2 += dot(weight_pair, source_pairs[source_word2 + pair]);
        }
        if (count > 3u) {
            sum3 += dot(weight_pair, source_pairs[source_word3 + pair]);
        }
    }

    partial0[lane] = sum0;
    partial1[lane] = sum1;
    partial2[lane] = sum2;
    partial3[lane] = sum3;
    barrier();

    if (lane < 64u) {
        partial0[lane] += partial0[lane + 64u];
        partial1[lane] += partial1[lane + 64u];
        partial2[lane] += partial2[lane + 64u];
        partial3[lane] += partial3[lane + 64u];
    }
    barrier();
    if (lane < 32u) {
        partial0[lane] += partial0[lane + 32u];
        partial1[lane] += partial1[lane + 32u];
        partial2[lane] += partial2[lane + 32u];
        partial3[lane] += partial3[lane + 32u];
    }
    barrier();
    if (lane < 16u) {
        partial0[lane] += partial0[lane + 16u];
        partial1[lane] += partial1[lane + 16u];
        partial2[lane] += partial2[lane + 16u];
        partial3[lane] += partial3[lane + 16u];
    }
    barrier();
    if (lane < 8u) {
        partial0[lane] += partial0[lane + 8u];
        partial1[lane] += partial1[lane + 8u];
        partial2[lane] += partial2[lane + 8u];
        partial3[lane] += partial3[lane + 8u];
    }
    barrier();
    if (lane < 4u) {
        partial0[lane] += partial0[lane + 4u];
        partial1[lane] += partial1[lane + 4u];
        partial2[lane] += partial2[lane + 4u];
        partial3[lane] += partial3[lane + 4u];
    }
    barrier();
    if (lane < 2u) {
        partial0[lane] += partial0[lane + 2u];
        partial1[lane] += partial1[lane + 2u];
        partial2[lane] += partial2[lane + 2u];
        partial3[lane] += partial3[lane + 2u];
    }
    barrier();

    if (lane == 0u) {
        destination_values[occurrence0 * pc.hidden_size + hidden] = partial0[0] + partial0[1];
        if (count > 1u) {
            destination_values[occurrence1 * pc.hidden_size + hidden] =
                partial1[0] + partial1[1];
        }
        if (count > 2u) {
            destination_values[occurrence2 * pc.hidden_size + hidden] =
                partial2[0] + partial2[1];
        }
        if (count > 3u) {
            destination_values[occurrence3 * pc.hidden_size + hidden] =
                partial3[0] + partial3[1];
        }
    }
}
