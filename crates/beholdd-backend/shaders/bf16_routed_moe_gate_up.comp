#version 460

// BF16 routed-MoE stage 1: for each (route, intermediate) pair, compute the
// gate and up projections together and store SiLU(gate) * up. One workgroup
// owns one output element and its 64 lanes cooperatively reduce the hidden
// dimension with a fixed tree.
//
// All routed-MoE stages use the same four-storage-buffer descriptor layout:
//   binding 0: source f32 activations
//   binding 1: packed row-major BF16 weights, addressed by metadata byte offsets
//   binding 2: destination f32 activations
//   binding 3: uint route metadata
//
// Route r owns four metadata words:
//   route_meta[4*r + 0] = gate matrix byte offset (shape [F,H])
//   route_meta[4*r + 1] = up matrix byte offset   (shape [F,H])
//   route_meta[4*r + 2] = down matrix byte offset (shape [H,F])
//   route_meta[4*r + 3] = floatBitsToUint(route weight)
//
// Offsets are relative to the beginning of binding 1. The host must validate
// that offsets are 2-byte aligned, every referenced BF16 lies within the
// descriptor range, and all offset/index products and sums fit in uint32. It
// must likewise validate H*F, K*F, K*H, and K*4 in uint32 before dispatch.
// A malformed out-of-range weight reference is read as zero as a final memory
// safety guard; it is not a substitute for host-side validation.
//
// Dispatch K*F workgroups, flattened over x then y. A compute-to-compute memory
// barrier is required before this destination is consumed by stage 2.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer SourceActivations {
    float source_values[];
};
layout(set = 0, binding = 1, std430) readonly buffer PackedWeight {
    uint weight_words[];
};
layout(set = 0, binding = 2, std430) buffer DestinationActivations {
    float destination_values[];
};
layout(set = 0, binding = 3, std430) readonly buffer RouteMetadata {
    uint route_meta[];
};

layout(push_constant) uniform Parameters {
    uint hidden_size;       // H
    uint intermediate_size; // F
    uint route_count;       // K
    uint accumulate;        // consumed by stage 3; ignored here
} pc;

shared float gate_partial[64];
shared float up_partial[64];

float load_bf16_at(uint byte_offset) {
    if ((byte_offset & 1u) != 0u) {
        return 0.0;
    }

    uint word_index = byte_offset >> 2u;
    if (word_index >= uint(weight_words.length())) {
        return 0.0;
    }

    uint shift = (byte_offset & 2u) * 8u;
    uint bits = (weight_words[word_index] >> shift) & 0xffffu;
    return uintBitsToFloat(bits << 16u);
}

void main() {
    if (pc.hidden_size == 0u || pc.intermediate_size == 0u || pc.route_count == 0u) {
        return;
    }

    uint workgroup = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint route = workgroup / pc.intermediate_size;
    if (route >= pc.route_count || route > 1073741823u) {
        return;
    }

    uint destination_index = workgroup;
    if (destination_index >= uint(destination_values.length()) ||
        pc.hidden_size > uint(source_values.length())) {
        return;
    }

    uint meta_index = route * 4u;
    if (uint(route_meta.length()) < 4u || meta_index > uint(route_meta.length()) - 4u) {
        return;
    }

    uint intermediate = workgroup % pc.intermediate_size;
    uint row_byte_offset = intermediate * pc.hidden_size * 2u;
    uint gate_base = route_meta[meta_index] + row_byte_offset;
    uint up_base = route_meta[meta_index + 1u] + row_byte_offset;
    uint lane = gl_LocalInvocationID.x;

    float gate_sum = 0.0;
    float up_sum = 0.0;
    for (uint hidden = lane; hidden < pc.hidden_size; hidden += 64u) {
        float activation = source_values[hidden];
        uint element_byte_offset = hidden * 2u;
        gate_sum += load_bf16_at(gate_base + element_byte_offset) * activation;
        up_sum += load_bf16_at(up_base + element_byte_offset) * activation;
    }

    gate_partial[lane] = gate_sum;
    up_partial[lane] = up_sum;
    barrier();

    for (uint stride = 32u; stride != 0u; stride >>= 1u) {
        if (lane < stride) {
            gate_partial[lane] += gate_partial[lane + stride];
            up_partial[lane] += up_partial[lane + stride];
        }
        barrier();
    }

    if (lane == 0u) {
        float gate = gate_partial[0];
        float silu = gate / (1.0 + exp(-gate));
        destination_values[destination_index] = silu * up_partial[0];
    }
}
