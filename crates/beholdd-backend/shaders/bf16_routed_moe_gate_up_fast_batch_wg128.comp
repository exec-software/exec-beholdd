#version 460

// Fixed-N paired-load BF16 routed-MoE stage 1 with a deterministic 128-lane
// reduction tree. One three-dimensional dispatch covers the complete independent
// batch:
//
//   vkCmdDispatch(intermediate_size, route_count, batch_size)
//   gl_WorkGroupID = {intermediate row, route, item}
//
// Descriptor ABI:
//   binding 0: tightly packed f32 inputs [N,H], exposed as vec2 values
//   binding 1: the complete packed row-major BF16 arena block
//   binding 2: tightly packed f32 destination scratch [N,K,F]
//   binding 3: four uint metadata words per item and route [N,K,4]
//              [absolute gate word offset, absolute up word offset,
//               absolute down word offset, floatBitsToUint(route weight)]
//
// The host guarantees exact nonzero dispatch dimensions, even H and F, complete
// tightly packed descriptor ranges, non-overlap, and non-wrapping uint products.
// Apart from integer item-base addressing, the dot products, pair iteration, SiLU,
// and reduction tree intentionally match bf16_routed_moe_gate_up_fast_wg128.comp.
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly restrict buffer SourceActivations {
    vec2 source_pairs[];
};
layout(set = 0, binding = 1, std430) readonly restrict buffer PackedWeight {
    uint weight_words[];
};
layout(set = 0, binding = 2, std430) writeonly restrict buffer DestinationActivations {
    float destination_values[];
};
layout(set = 0, binding = 3, std430) readonly restrict buffer RouteMetadata {
    uint route_meta[];
};

layout(push_constant) uniform Parameters {
    uint hidden_size;
    uint intermediate_size;
    uint route_count;
    uint accumulate;
} pc;

shared vec2 partial[128];

vec2 unpack_bf16_pair(uint packed) {
    return uintBitsToFloat(uvec2(packed << 16u, packed & 0xffff0000u));
}

void main() {
    uint intermediate = gl_WorkGroupID.x;
    uint route = gl_WorkGroupID.y;
    uint item = gl_WorkGroupID.z;
    uint lane = gl_LocalInvocationID.x;

    uint hidden_words = pc.hidden_size >> 1u;
    uint occurrence = item * pc.route_count + route;
    uint source_base = item * hidden_words;
    uint meta_index = occurrence << 2u;
    uint row_word_offset = intermediate * hidden_words;
    uint gate_word = route_meta[meta_index] + row_word_offset;
    uint up_word = route_meta[meta_index + 1u] + row_word_offset;

    vec2 sums = vec2(0.0);
    for (uint pair = lane; pair < hidden_words; pair += 128u) {
        vec2 activation = source_pairs[source_base + pair];
        sums += vec2(
            dot(unpack_bf16_pair(weight_words[gate_word + pair]), activation),
            dot(unpack_bf16_pair(weight_words[up_word + pair]), activation)
        );
    }

    partial[lane] = sums;
    barrier();

    if (lane < 64u) partial[lane] += partial[lane + 64u];
    barrier();
    if (lane < 32u) partial[lane] += partial[lane + 32u];
    barrier();
    if (lane < 16u) partial[lane] += partial[lane + 16u];
    barrier();
    if (lane < 8u) partial[lane] += partial[lane + 8u];
    barrier();
    if (lane < 4u) partial[lane] += partial[lane + 4u];
    barrier();
    if (lane < 2u) partial[lane] += partial[lane + 2u];
    barrier();

    if (lane == 0u) {
        vec2 totals = partial[0] + partial[1];
        float gate = totals.x;
        float silu = gate / (1.0 + exp(-gate));
        destination_values[occurrence * pc.intermediate_size + intermediate] =
            silu * totals.y;
    }
}
