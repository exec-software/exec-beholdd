#version 460

// BF16 routed-MoE stage 3: deterministically reduce route-major [K,H] f32
// outputs in metadata order. Each invocation owns one hidden element and walks
// routes from 0 through K-1, so route accumulation order is explicit and stable.
// A workgroup covers 64 adjacent hidden elements; dispatch ceil(H/64)
// workgroups, flattened over x then y.
//
// Shared descriptor ABI:
//   binding 0: source f32 activations (route-major [K,H])
//   binding 1: packed BF16 weights (inactive in this stage)
//   binding 2: destination f32 activation [H]
//   binding 3: route metadata, four uints per route:
//              gate byte offset, up byte offset, down byte offset,
//              floatBitsToUint(route weight)
//
// Push `accumulate == 0` to overwrite destination or nonzero to add the routed
// result to its existing contents. The host must validate H/F/K products and
// K*4 in uint32, metadata length, source/destination ranges, and flattened
// dispatch arithmetic before submission. Binding 1 intentionally remains in
// the common pipeline layout even though this shader has no weight reads.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer SourceActivations {
    float source_values[];
};
layout(set = 0, binding = 1, std430) readonly buffer PackedWeight {
    uint weight_words[];
};
layout(set = 0, binding = 2, std430) buffer DestinationActivations {
    float destination_values[];
};
layout(set = 0, binding = 3, std430) readonly buffer RouteMetadata {
    uint route_meta[];
};

layout(push_constant) uniform Parameters {
    uint hidden_size;       // H
    uint intermediate_size; // F, retained for the common ABI
    uint route_count;       // K
    uint accumulate;        // zero overwrites; nonzero accumulates
} pc;

void main() {
    if (pc.hidden_size == 0u || pc.route_count == 0u) {
        return;
    }

    uint workgroup = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint hidden = workgroup * 64u + gl_LocalInvocationID.x;
    if (hidden >= pc.hidden_size || hidden >= uint(destination_values.length())) {
        return;
    }

    // The host-side uint32 validation documented above makes these products
    // non-wrapping. Per-access checks still prevent malformed descriptors from
    // causing an out-of-bounds source or metadata read.
    float sum = 0.0;
    for (uint route = 0u; route < pc.route_count; ++route) {
        if (route > 1073741823u) {
            return;
        }
        uint meta_index = route * 4u;
        if (uint(route_meta.length()) < 4u || meta_index > uint(route_meta.length()) - 4u) {
            return;
        }

        uint source_index = route * pc.hidden_size + hidden;
        if (source_index >= uint(source_values.length())) {
            return;
        }

        float route_weight = uintBitsToFloat(route_meta[meta_index + 3u]);
        sum += route_weight * source_values[source_index];
    }

    if (pc.accumulate != 0u) {
        destination_values[hidden] += sum;
    } else {
        destination_values[hidden] = sum;
    }
}
