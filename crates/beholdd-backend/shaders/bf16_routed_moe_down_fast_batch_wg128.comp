#version 460

// Fixed-N paired-load BF16 routed-MoE stage 2 with the same deterministic
// 128-lane tree as the qualified single-item kernel:
//
//   vkCmdDispatch(hidden_size, route_count, batch_size)
//   gl_WorkGroupID = {hidden row, route, item}
//
// Descriptor ABI:
//   binding 0: tightly packed f32 stage-1 scratch [N,K,F], exposed as vec2
//   binding 1: the complete packed row-major BF16 arena block
//   binding 2: tightly packed f32 destination scratch [N,K,H]
//   binding 3: four uint metadata words per item and route [N,K,4]
//
// Metadata contains absolute arena-block word offsets. The host validates exact
// dispatch dimensions, tightly packed ranges, even H/F, and every uint product.
// Floating-point operations and their order intentionally match
// bf16_routed_moe_down_fast_wg128.comp.
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly restrict buffer SourceActivations {
    vec2 source_pairs[];
};
layout(set = 0, binding = 1, std430) readonly restrict buffer PackedWeight {
    uint weight_words[];
};
layout(set = 0, binding = 2, std430) writeonly restrict buffer DestinationActivations {
    float destination_values[];
};
layout(set = 0, binding = 3, std430) readonly restrict buffer RouteMetadata {
    uint route_meta[];
};

layout(push_constant) uniform Parameters {
    uint hidden_size;
    uint intermediate_size;
    uint route_count;
    uint accumulate;
} pc;

shared float partial[128];

vec2 unpack_bf16_pair(uint packed) {
    return uintBitsToFloat(uvec2(packed << 16u, packed & 0xffff0000u));
}

void main() {
    uint hidden = gl_WorkGroupID.x;
    uint route = gl_WorkGroupID.y;
    uint item = gl_WorkGroupID.z;
    uint lane = gl_LocalInvocationID.x;

    uint intermediate_words = pc.intermediate_size >> 1u;
    uint occurrence = item * pc.route_count + route;
    uint source_word = occurrence * intermediate_words;
    uint meta_index = occurrence << 2u;
    uint row_word = route_meta[meta_index + 2u] + hidden * intermediate_words;

    float sum = 0.0;
    for (uint pair = lane; pair < intermediate_words; pair += 128u) {
        sum += dot(
            unpack_bf16_pair(weight_words[row_word + pair]),
            source_pairs[source_word + pair]
        );
    }

    partial[lane] = sum;
    barrier();

    if (lane < 64u) partial[lane] += partial[lane + 64u];
    barrier();
    if (lane < 32u) partial[lane] += partial[lane + 32u];
    barrier();
    if (lane < 16u) partial[lane] += partial[lane + 16u];
    barrier();
    if (lane < 8u) partial[lane] += partial[lane + 8u];
    barrier();
    if (lane < 4u) partial[lane] += partial[lane + 4u];
    barrier();
    if (lane < 2u) partial[lane] += partial[lane + 2u];
    barrier();

    if (lane == 0u) {
        destination_values[occurrence * pc.hidden_size + hidden] = partial[0] + partial[1];
    }
}
