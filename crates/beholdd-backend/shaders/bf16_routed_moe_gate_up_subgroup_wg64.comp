#version 460
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require

// Paired-load BF16 routed-MoE stage 1 using subgroup arithmetic in a static
// 64-lane workgroup. The descriptor and push-constant ABI matches *_fast.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly restrict buffer SourceActivations {
    vec2 source_pairs[];
};
layout(set = 0, binding = 1, std430) readonly restrict buffer PackedWeight {
    uint weight_words[];
};
layout(set = 0, binding = 2, std430) writeonly restrict buffer DestinationActivations {
    float destination_values[];
};
layout(set = 0, binding = 3, std430) readonly restrict buffer RouteMetadata {
    uint route_meta[];
};

layout(push_constant) uniform Parameters {
    uint hidden_size;
    uint intermediate_size;
    uint route_count;
    uint accumulate;
} pc;

shared vec2 subgroup_totals[64];

vec2 unpack_bf16_pair(uint packed) {
    return uintBitsToFloat(uvec2(packed << 16u, packed & 0xffff0000u));
}

void main() {
    uint intermediate = gl_WorkGroupID.x;
    uint route = gl_WorkGroupID.y;
    uint lane = gl_LocalInvocationID.x;

    uint hidden_words = pc.hidden_size >> 1u;
    uint meta_index = route << 2u;
    uint row_word_offset = intermediate * hidden_words;
    uint gate_word = route_meta[meta_index] + row_word_offset;
    uint up_word = route_meta[meta_index + 1u] + row_word_offset;

    vec2 sums = vec2(0.0);
    for (uint pair = lane; pair < hidden_words; pair += 64u) {
        vec2 activation = source_pairs[pair];
        sums += vec2(
            dot(unpack_bf16_pair(weight_words[gate_word + pair]), activation),
            dot(unpack_bf16_pair(weight_words[up_word + pair]), activation)
        );
    }

    vec2 subgroup_total = subgroupAdd(sums);
    if (subgroupElect()) {
        subgroup_totals[gl_SubgroupID] = subgroup_total;
    }
    barrier();

    if (lane == 0u) {
        vec2 totals = vec2(0.0);
        for (uint subgroup = 0u; subgroup < gl_NumSubgroups; ++subgroup) {
            totals += subgroup_totals[subgroup];
        }
        float gate = totals.x;
        float silu = gate / (1.0 + exp(-gate));
        destination_values[route * pc.intermediate_size + intermediate] = silu * totals.y;
    }
}
