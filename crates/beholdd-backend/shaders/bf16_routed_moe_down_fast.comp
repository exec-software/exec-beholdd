#version 460

// Fast BF16 routed-MoE stage 2 for host-validated inputs.
//
// Dispatch the logical output directly as:
//
//   vkCmdDispatch(hidden_size, route_count, 1)
//   gl_WorkGroupID.x = hidden row, gl_WorkGroupID.y = route
//
// Descriptor ABI:
//   binding 0: f32 stage-1 values [K,F], exposed as (K*F)/2 vec2 values
//   binding 1: packed row-major BF16 weight words
//   binding 2: f32 destination [K,H]
//   binding 3: four uint metadata words per route
//              [gate word offset, up word offset, down word offset,
//               floatBitsToUint(route weight)]
//
// Weight offsets are uint-word offsets relative to binding 1. The host must
// guarantee nonzero even H and F, 8-byte alignment for binding 0, 4-byte
// alignment for binding 1, exact dispatch dimensions, non-overlapping
// restrict-qualified descriptors, and all accesses/products in range.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly restrict buffer SourceActivations {
    vec2 source_pairs[];
};
layout(set = 0, binding = 1, std430) readonly restrict buffer PackedWeight {
    uint weight_words[];
};
layout(set = 0, binding = 2, std430) writeonly restrict buffer DestinationActivations {
    float destination_values[];
};
layout(set = 0, binding = 3, std430) readonly restrict buffer RouteMetadata {
    uint route_meta[];
};

layout(push_constant) uniform Parameters {
    uint hidden_size;       // H, nonzero and even
    uint intermediate_size; // F, nonzero and even
    uint route_count;       // K, retained for the common stage ABI
    uint accumulate;        // consumed by stage 3; ignored here
} pc;

shared float partial[64];

vec2 unpack_bf16_pair(uint packed) {
    return uintBitsToFloat(uvec2(packed << 16u, packed & 0xffff0000u));
}

void main() {
    uint hidden = gl_WorkGroupID.x;
    uint route = gl_WorkGroupID.y;
    uint lane = gl_LocalInvocationID.x;

    uint intermediate_words = pc.intermediate_size >> 1u;
    uint source_word = route * intermediate_words;
    uint meta_index = route << 2u;
    uint row_word = route_meta[meta_index + 2u] + hidden * intermediate_words;

    float sum = 0.0;
    for (uint pair = lane; pair < intermediate_words; pair += 64u) {
        sum += dot(
            unpack_bf16_pair(weight_words[row_word + pair]),
            source_pairs[source_word + pair]
        );
    }

    partial[lane] = sum;
    barrier();

    if (lane < 32u) partial[lane] += partial[lane + 32u];
    barrier();
    if (lane < 16u) partial[lane] += partial[lane + 16u];
    barrier();
    if (lane < 8u) partial[lane] += partial[lane + 8u];
    barrier();
    if (lane < 4u) partial[lane] += partial[lane + 4u];
    barrier();
    if (lane < 2u) partial[lane] += partial[lane + 2u];
    barrier();

    if (lane == 0u) {
        destination_values[route * pc.hidden_size + hidden] = partial[0] + partial[1];
    }
}
